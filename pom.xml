<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.5</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.erikjarquin</groupId>
	<artifactId>compras</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>compras-backend</name>
	<description>Backend del sistema de tienda de comida: POS local (Angular) + tienda online (Next.js) contra una sola BD.</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-h2console</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.11.5</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.11.5</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.11.5</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--Dependencia de flyway-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!--Dependencia para el correo electronico-->
		<dependency>
    		<groupId>org.springframework.boot</groupId>
    		<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		
		<!--
			Tests de controladores (MockMvc): spring-boot-starter-webmvc-test trae
			@WebMvcTest / MockMvc / AssertJ / Mockito; spring-security-test trae
			@WithMockUser para probar @PreAuthorize sin generar tokens JWT reales.
			Sin estas dependencias los tests de controllers no compilan.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!--
				Plugin de Flyway para poder hablar con la BD SIN arrancar la app.

				Hace falta porque Spring Boot ejecuta el `validate` de Flyway en el
				arranque: si una migración YA APLICADA cambia, el contexto aborta y no
				deja hacer nada más — ni ver el estado, ni repararlo. Con este plugin
				se revisa (`flyway:info`, `flyway:validate`) y se re-baselinea
				(`flyway:repair`) sin levantar Tomcat ni HikariCP.

				La versión del plugin la aporta spring-boot-starter-parent
				(pluginManagement), así que no se escribe a mano: ponerla sería
				garantizar que Maven y la app calculen los checksums con algoritmos
				distintos y volver el problema del checksum mismatch.

				SIN credenciales a propósito: este pom.xml SÍ se sube a git. Se pasan
				por línea de comandos con -Dflyway.url / -Dflyway.user / -Dflyway.password
				tomadas de src/main/resources/application-local.yaml (que está en
				.gitignore), o mejor desde ~/.m2/settings.xml.

				El <dependency> de abajo NO es opcional: desde Flyway 10 el soporte de
				PostgreSQL vive en un módulo aparte. Sin él el plugin falla con
				"No database found to handle jdbc:postgresql://".

				Sí lleva <version>: a diferencia de las dependencias del proyecto, las
				de un <plugin> NO heredan del <dependencyManagement> del POM. Por eso
				se escribe ${flyway.version} (la propiedad que define el BOM de Spring
				Boot) en vez de un número fijo — así el módulo sigue pegado a la misma
				versión de Flyway que usa la app.
			-->
			<plugin>
				<groupId>org.flywaydb</groupId>
				<artifactId>flyway-maven-plugin</artifactId>
				<dependencies>
					<dependency>
						<groupId>org.flywaydb</groupId>
						<artifactId>flyway-database-postgresql</artifactId>
						<version>${flyway.version}</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>

</project>
